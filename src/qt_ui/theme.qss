/* ============================================================
   Migration Platform — Material Blue Theme
   Soft, rounded, borderless cards with a Material-You-inspired
   blue accent. Dark navy sidebar, light blue-tinted page background.
   Primary blue: #3F6FE0  |  Success green: #388E3C
   ============================================================ */

/* === Base === */

QMainWindow {
    background: #F5F8FF;
}

QWidget {
    color: #1B1E28;
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 16px;
}

QWidget#RootSurface {
    background: transparent;
}

/* === Per-page header typography === */

QLabel#PageIcon {
    font-size: 41px;
    background: transparent;
}

QLabel#PageTitle {
    color: #1B1E28;
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -0.3px;
}

QLabel#PageSubtitle {
    color: #5A6072;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
}

/* === Typography === */

QLabel#AppTitle {
    color: #1B1E28;
    font-size: 23px;
    font-weight: 800;
    letter-spacing: -0.5px;
}

QLabel#AppSubtitle {
    color: #78889E;
    font-size: 14px;
    font-weight: 400;
}

QLabel#StepTitle {
    color: #1B1E28;
    font-size: 23px;
    font-weight: 700;
}

QLabel#SectionTitle {
    color: #3F6FE0;
    font-size: 17px;
    font-weight: 700;
    margin-top: 6px;
}

QLabel#HeroTitle {
    color: #3F6FE0;
    font-size: 23px;
    font-weight: 700;
}

QLabel#BodyText {
    color: #3E4559;
    font-size: 16px;
}

/* === Status chips & banners (used sparingly) === */

QLabel#TrustBanner {
    color: #1B3A86;
    background: #DCE6FF;
    border: none;
    border-radius: 16px;
    padding: 9px 16px;
    font-size: 15px;
    font-weight: 600;
}

QLabel#StatChip {
    color: #1B3A86;
    background: #DCE6FF;
    border: none;
    border-radius: 10px;
    padding: 4px 10px;
    font-size: 14px;
    font-weight: 600;
}

QLabel#ErrorBanner {
    color: #B71C1C;
    background: #FFEBEE;
    border: none;
    border-radius: 16px;
    padding: 9px 16px;
    font-size: 15px;
    font-weight: 600;
}

QLabel#FooterBadge {
    color: #5A6072;
    background: #EEF1FA;
    border: none;
    border-radius: 10px;
    padding: 4px 10px;
    font-size: 14px;
    font-weight: 500;
}

QLabel#StatusPill {
    color: #5A6072;
    background: #EEF1FA;
    border: none;
    border-radius: 10px;
    padding: 4px 10px;
    font-size: 14px;
    font-weight: 500;
}

/* ================================================================
   DARK SIDEBAR STEPPER
   ================================================================ */

QWidget#StepperPanel {
    background: #16223D;
}

QLabel#StepperTitle {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
}

/* Completed step rows are clickable — show a subtle hover highlight */
QWidget[clickable="true"] {
    border-radius: 14px;
}

QWidget[clickable="true"]:hover {
    background: rgba(255, 255, 255, 0.09);
    border-radius: 14px;
}

QLabel#StepperSubtitle {
    color: rgba(255, 255, 255, 0.45);
    font-size: 13px;
}

QFrame#StepperSeparator {
    background: rgba(255, 255, 255, 0.12);
    max-height: 1px;
}

/* Step dots — pending (default), active, done */

QLabel#StepDot {
    background: rgba(255, 255, 255, 0.10);
    border: 1.5px solid rgba(255, 255, 255, 0.30);
    border-radius: 13px;
    color: rgba(255, 255, 255, 0.65);
    font-size: 13px;
    font-weight: 700;
}

QLabel#StepDot[state="pending"] {
    background: rgba(255, 255, 255, 0.10);
    border: 1.5px solid rgba(255, 255, 255, 0.30);
    color: rgba(255, 255, 255, 0.65);
}

QLabel#StepDot[state="active"] {
    background: #3F6FE0;
    border: 2px solid rgba(63, 111, 224, 0.55);
    color: white;
}

QLabel#StepDot[state="done"] {
    background: #3F6FE0;
    border: 2px solid rgba(63, 111, 224, 0.4);
    color: white;
}

/* Step text — pending (default), active, done */

QLabel#StepHeading {
    color: rgba(255, 255, 255, 0.65);
    font-size: 14px;
    font-weight: 600;
}

QLabel#StepMeta {
    color: rgba(255, 255, 255, 0.45);
    font-size: 13px;
}

QLabel#StepHeading[state="pending"] {
    color: rgba(255, 255, 255, 0.65);
    font-weight: 600;
}

QLabel#StepMeta[state="pending"] {
    color: rgba(255, 255, 255, 0.45);
}

QLabel#StepHeading[state="active"] {
    color: #FFFFFF;
    font-weight: 700;
}

QLabel#StepMeta[state="active"] {
    color: rgba(140, 175, 250, 0.95);
}

QLabel#StepHeading[state="done"] {
    color: rgba(255, 255, 255, 0.75);
}

QLabel#StepMeta[state="done"] {
    color: rgba(140, 175, 250, 0.8);
}

QLabel#StepText {
    color: rgba(255, 255, 255, 0.65);
    font-size: 14px;
}

QLabel#StepText[state="pending"] {
    color: rgba(255, 255, 255, 0.65);
}

QLabel#StepText[state="active"] {
    color: #8CAFFA;
    font-weight: 700;
}

QLabel#StepText[state="done"] {
    color: rgba(255, 255, 255, 0.75);
}

/* ================================================================
   CONTENT AREA — cards, surfaces (white, soft, borderless)
   ================================================================ */

QWidget#StepCard {
    background: #FFFFFF;
    border: none;
    border-radius: 20px;
}

QFrame[card="true"] {
    background: #FFFFFF;
    border: none;
    border-radius: 16px;
}

QFrame[card="true"][selected="true"] {
    border: 2px solid #3F6FE0;
    background: #EAF0FF;
}

/* Flat tinted grouping for a page's main sections — distinct from the plain
   white card="true" (used where an inner widget, like a choice card, already
   carries its own visible background) so a section reads as a group instead
   of disappearing against the white StepCard behind it. */
QFrame[card="section"] {
    background: #F5F8FF;
    border: 1px solid #E7ECF8;
    border-radius: 16px;
}

/* Individual choice cards inside a guided questionnaire (radio + hint) */
QFrame[choice="true"] {
    background: #FFFFFF;
    border: 1.5px solid transparent;
    border-radius: 16px;
}

QFrame[choice="true"]:hover {
    background: #F5F8FF;
}

QFrame[choice="true"][selected="true"] {
    background: #EAF0FF;
    border: 2px solid #3F6FE0;
}

/* ================================================================
   BUTTONS
   ================================================================ */

QPushButton {
    background: #EEF1FA;
    border: none;
    color: #3E4559;
    border-radius: 18px;
    padding: 8px 18px;
    font-weight: 600;
}

QPushButton:hover {
    background: #E3E8F7;
}

QPushButton:pressed {
    background: #D6DEF3;
}

QPushButton[role="cta"] {
    background: #3F6FE0;
    border: none;
    color: #FFFFFF;
    padding: 10px 26px;
    border-radius: 19px;
    font-weight: 700;
    font-size: 16px;
}

QPushButton[role="cta"]:hover {
    background: #5C84E8;
}

QPushButton[role="cta"]:pressed {
    background: #2C56C2;
}

QPushButton[role="cta"]:disabled {
    background: #B7C6EF;
    color: #F0F3FC;
}

QPushButton[role="badge"] {
    background: #EEF1FA;
    border: none;
    color: #5A6072;
    border-radius: 19px;
    padding: 6px 16px;
    font-size: 15px;
    font-weight: 600;
}

QPushButton[role="badge"]:hover {
    background: #E3E8F7;
}

QPushButton[role="badge"]:disabled {
    background: #F4F5FA;
    color: #B3B8C6;
}

QPushButton[role="danger"] {
    background: #FFEBEE;
    border: none;
    color: #C62828;
    border-radius: 16px;
}

QPushButton[role="danger"]:hover {
    background: #FFCDD2;
}

/* ================================================================
   INPUTS
   ================================================================ */

QLineEdit,
QComboBox,
QTextEdit {
    background: #FFFFFF;
    border: 1.5px solid #E7ECF8;
    border-radius: 14px;
    padding: 7px 12px;
    color: #1B1E28;
}

QLineEdit:focus,
QComboBox:focus,
QTextEdit:focus {
    border-color: #3F6FE0;
}

/* === Report / preview text areas used across wizard pages === */

QTextEdit#ReportView {
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 16px;
    border: none;
    border-radius: 18px;
    padding: 16px 18px;
    background: #EEF2FF;
    color: #1B1E28;
}

QTextEdit#ReportView:focus {
    border: none;
}

QTextEdit#ReportView QScrollBar:vertical {
    width: 6px;
    background: transparent;
}

QTextEdit#ReportView QScrollBar::handle:vertical {
    background: #B7C9F7;
    border-radius: 3px;
    min-height: 20px;
}

QTextEdit#ReportView QScrollBar::add-line:vertical,
QTextEdit#ReportView QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ================================================================
   GLOBAL SCAN BAR (fixed position above content, always visible)
   ================================================================ */

QProgressBar#GlobalScanBar {
    border: none;
    border-radius: 2px;
    background: #DCE6FF;
    min-height: 4px;
    max-height: 4px;
}

QProgressBar#GlobalScanBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3F6FE0, stop:1 #7BA0F2);
    border-radius: 2px;
}

/* ================================================================
   PROGRESS BAR
   ================================================================ */

QProgressBar {
    background: #EEF1FA;
    border: none;
    border-radius: 8px;
    text-align: center;
    color: #5A6072;
    font-weight: 600;
    font-size: 14px;
    min-height: 16px;
}

QProgressBar::chunk {
    border-radius: 8px;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #3F6FE0,
        stop: 1 #7BA0F2
    );
}

/* ================================================================
   DOCK WIDGET (expert panel)
   ================================================================ */

QDockWidget {
    color: #1B1E28;
    font-size: 16px;
    font-weight: 700;
    border: none;
    background: #FFFFFF;
}

QDockWidget::title {
    background: #F5F8FF;
    border-bottom: 1px solid #E7ECF8;
    text-align: left;
    padding: 8px 12px;
    color: #3E4559;
}

QDockWidget QWidget {
    background: #FFFFFF;
}

/* ================================================================
   SPLITTER
   ================================================================ */

QSplitter#MainSplitter::handle {
    background: transparent;
}

QSplitter#MainSplitter::handle:hover {
    background: rgba(63, 111, 224, 0.08);
}

/* ================================================================
   GROUP BOX
   ================================================================ */

QGroupBox {
    border: 1.5px solid #E7ECF8;
    border-radius: 16px;
    margin-top: 10px;
    padding-top: 14px;
    font-size: 14px;
    font-weight: 600;
    color: #78889E;
    background: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #78889E;
}

/* ================================================================
   TABLE
   ================================================================ */

QTableWidget {
    background: #FFFFFF;
    border: none;
    border-radius: 14px;
    gridline-color: #F0F3FB;
}

QHeaderView::section {
    background: #F5F8FF;
    color: #5A6072;
    font-weight: 700;
    border: none;
    border-bottom: 1px solid #E7ECF8;
    padding: 7px 8px;
}

/* ================================================================
   CHECKBOXES & RADIO BUTTONS
   ================================================================ */

QCheckBox {
    spacing: 10px;
    color: #3E4559;
}

QCheckBox::indicator,
QListWidget::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1.5px solid #C3CCE4;
    background: white;
}

QCheckBox::indicator:checked,
QListWidget::indicator::checked {
    background-color: #3F6FE0;
    border: 1.5px solid #3F6FE0;
    image: url("src/qt_ui/assets/checkmark_white.ico");
}

QCheckBox::indicator:hover {
    border: 1.5px solid #3F6FE0;
}

QRadioButton {
    spacing: 6px;
    color: #3E4559;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1.5px solid #C3CCE4;
    background: white;
}

QRadioButton::indicator:hover {
    border: 1.5px solid #3F6FE0;
}

QRadioButton::indicator:checked {
    border: 1.5px solid #3F6FE0;
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.4,
        fx: 0.5, fy: 0.5,
        stop: 0 #3F6FE0,
        stop: 1 #FFFFFF
    );
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    border: 1.5px solid #E7ECF8;
    background: #F5F8FF;
}

QCheckBox:focus,
QRadioButton:focus {
    outline: none;
}

/* ================================================================
   ACTIVITY CONSOLE
   ================================================================ */

QGroupBox#ActivityGroup {
    border: 1.5px solid #E7ECF8;
    border-radius: 16px;
    background: #F8FAFF;
    color: #3E4559;
    margin-top: 0;
    padding-top: 8px;
}

QLabel#ActivityStatus {
    color: #5A6072;
    font-size: 14px;
    font-weight: 500;
}

QListWidget#ActivityLog {
    border: none;
    border-radius: 14px;
    padding: 4px;
    font-family: "Consolas", "Cascadia Mono", monospace;
    font-size: 14px;
    background: #16223D;
    color: #CBD5E1;
}

QListWidget#ActivityLog::item {
    padding: 3px 6px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
}

QWidget#LogFiltersPanel {
    background: #EEF1FA;
    border: none;
    border-radius: 14px;
}

QWidget#LogFiltersPanel QCheckBox {
    color: #5A6072;
    font-size: 14px;
    font-weight: 600;
}

QWidget#LogFiltersPanel QCheckBox::indicator {
    width: 12px;
    height: 12px;
    border-radius: 6px;
}

/* ================================================================
   TAB WIDGET
   ================================================================ */

QTabWidget#ExpertTabs::pane {
    border: none;
    border-radius: 16px;
    background: #FFFFFF;
    top: -1px;
}

QTabBar::tab {
    background: #EEF1FA;
    border: none;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    min-width: 90px;
    padding: 6px 14px;
    color: #78889E;
    font-weight: 500;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #3F6FE0;
    font-weight: 700;
}

/* ================================================================
   SCROLL AREA
   ================================================================ */

QScrollArea {
    background: transparent;
    border: none;
}

/* ================================================================
   SCROLLBARS — visible track + handle for page scroll areas
   ================================================================ */

QScrollBar:vertical {
    width: 10px;
    background: #EEF1FA;
    border: none;
    border-radius: 5px;
    margin: 2px 1px;
}

QScrollBar::handle:vertical {
    background: #AFC0EE;
    border-radius: 4px;
    min-height: 36px;
}

QScrollBar::handle:vertical:hover {
    background: #7BA0F2;
}

QScrollBar::handle:vertical:pressed {
    background: #3F6FE0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: transparent;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QStackedWidget#PageStack {
    background: transparent;
}

/* ================================================================
   HORIZONTAL STEPPER (if used)
   ================================================================ */

QWidget#HorizontalStepper {
    background: transparent;
}

QLabel#StepLabel {
    color: #AEB8CC;
    font-size: 15px;
    font-weight: 600;
}

QLabel#StepLabel[state="active"] {
    color: #3F6FE0;
    font-weight: 700;
}

QLabel#StepLabel[state="done"] {
    color: #388E3C;
    font-weight: 700;
}

QLabel#StepLabel[state="pending"] {
    color: #C3CCE4;
    font-weight: 500;
}
