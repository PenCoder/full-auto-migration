/* ============================================================
   Migration Platform — Clean Professional Theme
   Inspired by modern desktop tools (dark sidebar, white content)
   Primary blue: #1565C0  |  Success green: #388E3C
   ============================================================ */

/* === Base === */

QMainWindow {
    background: #FFFFFF;
}

QWidget {
    color: #0D1929;
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 14px;
}

QWidget#RootSurface {
    background: transparent;
}

/* === Per-page header typography === */

QLabel#PageIcon {
    font-size: 36px;
    background: transparent;
}

QLabel#PageTitle {
    color: #0D1929;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.3px;
}

QLabel#PageSubtitle {
    color: #546E7A;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
}

/* === Typography === */

QLabel#AppTitle {
    color: #0D1929;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.5px;
}

QLabel#AppSubtitle {
    color: #78909C;
    font-size: 12px;
    font-weight: 400;
}

QLabel#StepTitle {
    color: #0D1929;
    font-size: 20px;
    font-weight: 700;
}

QLabel#SectionTitle {
    color: #1565C0;
    font-size: 15px;
    font-weight: 700;
    margin-top: 6px;
}

QLabel#HeroTitle {
    color: #1565C0;
    font-size: 20px;
    font-weight: 700;
}

QLabel#BodyText {
    color: #37474F;
    font-size: 14px;
}

/* === Status chips & banners (used sparingly) === */

QLabel#TrustBanner {
    color: #1B5E20;
    background: #E8F5E9;
    border: 1px solid #C8E6C9;
    border-radius: 10px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
}

QLabel#StatChip {
    color: #1565C0;
    background: #E3F2FD;
    border: 1px solid #BBDEFB;
    border-radius: 8px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#ErrorBanner {
    color: #B71C1C;
    background: #FFEBEE;
    border: 1px solid #FFCDD2;
    border-radius: 10px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
}

QLabel#FooterBadge {
    color: #546E7A;
    background: #F5F5F5;
    border: 1px solid #E0E0E0;
    border-radius: 10px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 500;
}

QLabel#StatusPill {
    color: #546E7A;
    background: #F5F5F5;
    border: 1px solid #E0E0E0;
    border-radius: 10px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 500;
}

/* ================================================================
   DARK SIDEBAR STEPPER
   ================================================================ */

QWidget#StepperPanel {
    background: #0D1929;
}

QLabel#StepperTitle {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
}

QLabel#StepperSubtitle {
    color: rgba(255, 255, 255, 0.45);
    font-size: 11px;
}

QFrame#StepperSeparator {
    background: rgba(255, 255, 255, 0.12);
    max-height: 1px;
}

/* Step dots — pending (default), active, done */

QLabel#StepDot {
    background: rgba(255, 255, 255, 0.12);
    border: 1.5px solid rgba(255, 255, 255, 0.40);
    border-radius: 13px;
    color: rgba(255, 255, 255, 0.65);
    font-size: 11px;
    font-weight: 700;
}

QLabel#StepDot[state="pending"] {
    background: rgba(255, 255, 255, 0.12);
    border: 1.5px solid rgba(255, 255, 255, 0.40);
    color: rgba(255, 255, 255, 0.65);
}

QLabel#StepDot[state="active"] {
    background: #1976D2;
    border: 2px solid rgba(33, 150, 243, 0.6);
    color: white;
}

QLabel#StepDot[state="done"] {
    background: #388E3C;
    border: 2px solid rgba(76, 175, 80, 0.5);
    color: white;
}

/* Step text — pending (default), active, done */

QLabel#StepHeading {
    color: rgba(255, 255, 255, 0.65);
    font-size: 12px;
    font-weight: 600;
}

QLabel#StepMeta {
    color: rgba(255, 255, 255, 0.45);
    font-size: 11px;
}

QLabel#StepHeading[state="pending"] {
    color: rgba(255, 255, 255, 0.65);
    font-weight: 600;
}

QLabel#StepMeta[state="pending"] {
    color: rgba(255, 255, 255, 0.45);
}

QLabel#StepHeading[state="active"] {
    color: #FFFFFF;
    font-weight: 700;
}

QLabel#StepMeta[state="active"] {
    color: rgba(100, 181, 246, 0.95);
}

QLabel#StepHeading[state="done"] {
    color: rgba(255, 255, 255, 0.75);
}

QLabel#StepMeta[state="done"] {
    color: #81C784;
}

QLabel#StepText {
    color: rgba(255, 255, 255, 0.65);
    font-size: 12px;
}

QLabel#StepText[state="pending"] {
    color: rgba(255, 255, 255, 0.65);
}

QLabel#StepText[state="active"] {
    color: #64B5F6;
    font-weight: 700;
}

QLabel#StepText[state="done"] {
    color: rgba(255, 255, 255, 0.75);
}

/* ================================================================
   CONTENT AREA — cards, surfaces (white, clean)
   ================================================================ */

QWidget#StepCard {
    background: #FFFFFF;
    border: 1px solid #EEEEEE;
    border-radius: 12px;
}

QFrame[card="true"] {
    background: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 10px;
}

QFrame[card="true"][selected="true"] {
    border: 2px solid #1565C0;
    background: #F8FBFF;
}

/* ================================================================
   BUTTONS
   ================================================================ */

QPushButton {
    background: #FFFFFF;
    border: 1px solid #E0E0E0;
    color: #37474F;
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background: #F5F5F5;
    border-color: #BDBDBD;
}

QPushButton:pressed {
    background: #EEEEEE;
}

QPushButton[role="cta"] {
    background: #1565C0;
    border: none;
    color: #FFFFFF;
    padding: 10px 24px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 14px;
}

QPushButton[role="cta"]:hover {
    background: #1976D2;
}

QPushButton[role="cta"]:pressed {
    background: #0D47A1;
}

QPushButton[role="primary"] {
    background: #1565C0;
    border: none;
    color: #FFFFFF;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 700;
}

QPushButton[role="primary"]:hover {
    background: #1976D2;
}

QPushButton[role="badge"] {
    background: #F5F5F5;
    border: 1px solid #E0E0E0;
    color: #546E7A;
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton[role="badge"]:hover {
    background: #EEEEEE;
    border-color: #BDBDBD;
}

QPushButton[role="danger"] {
    background: #FFEBEE;
    border: 1px solid #FFCDD2;
    color: #C62828;
    border-radius: 8px;
}

QPushButton[role="danger"]:hover {
    background: #FFCDD2;
}

/* ================================================================
   INPUTS
   ================================================================ */

QLineEdit,
QComboBox,
QTextEdit {
    background: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    padding: 7px 10px;
    color: #0D1929;
}

QLineEdit:focus,
QComboBox:focus,
QTextEdit:focus {
    border-color: #1565C0;
}

/* ================================================================
   PROGRESS BAR
   ================================================================ */

QProgressBar {
    background: #F5F5F5;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    text-align: center;
    color: #546E7A;
    font-weight: 600;
    font-size: 12px;
    min-height: 16px;
}

QProgressBar::chunk {
    border-radius: 6px;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #1565C0,
        stop: 1 #42A5F5
    );
}

/* ================================================================
   DOCK WIDGET (expert panel)
   ================================================================ */

QDockWidget {
    color: #0D1929;
    font-size: 14px;
    font-weight: 700;
    border: 1px solid #E0E0E0;
    background: #FFFFFF;
}

QDockWidget::title {
    background: #F5F5F5;
    border-bottom: 1px solid #E0E0E0;
    text-align: left;
    padding: 8px 12px;
    color: #37474F;
}

QDockWidget QWidget {
    background: #FFFFFF;
}

/* ================================================================
   SPLITTER
   ================================================================ */

QSplitter#MainSplitter::handle {
    background: transparent;
}

QSplitter#MainSplitter::handle:hover {
    background: rgba(0, 0, 0, 0.06);
}

/* ================================================================
   GROUP BOX
   ================================================================ */

QGroupBox {
    border: 1px solid #EEEEEE;
    border-radius: 10px;
    margin-top: 10px;
    padding-top: 14px;
    font-size: 12px;
    font-weight: 600;
    color: #78909C;
    background: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #78909C;
}

/* ================================================================
   TABLE
   ================================================================ */

QTableWidget {
    background: #FFFFFF;
    border: 1px solid #EEEEEE;
    border-radius: 8px;
    gridline-color: #F5F5F5;
}

QHeaderView::section {
    background: #FAFAFA;
    color: #546E7A;
    font-weight: 700;
    border: none;
    border-bottom: 1px solid #E0E0E0;
    padding: 7px 8px;
}

/* ================================================================
   CHECKBOXES & RADIO BUTTONS
   ================================================================ */

QCheckBox {
    spacing: 10px;
    color: #37474F;
}

QCheckBox::indicator,
QListWidget::indicator {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border: 1.5px solid #BDBDBD;
    background: white;
}

QCheckBox::indicator:checked,
QListWidget::indicator::checked {
    background-color: #1565C0;
    border: 1.5px solid #1565C0;
    image: url("src/qt_ui/assets/checkmark_white.ico");
}

QCheckBox::indicator:hover {
    border: 1.5px solid #1565C0;
}

QRadioButton {
    spacing: 6px;
    color: #37474F;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border: 1.5px solid #BDBDBD;
    background: white;
}

QRadioButton::indicator:hover {
    border: 1.5px solid #1565C0;
}

QRadioButton::indicator:checked {
    border: 1.5px solid #1565C0;
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.4,
        fx: 0.5, fy: 0.5,
        stop: 0 #1565C0,
        stop: 1 #FFFFFF
    );
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    border: 1.5px solid #E0E0E0;
    background: #F5F5F5;
}

QCheckBox:focus,
QRadioButton:focus {
    outline: none;
}

/* ================================================================
   ACTIVITY CONSOLE
   ================================================================ */

QGroupBox#ActivityGroup {
    border: 1px solid #DDEEFF;
    border-radius: 10px;
    background: #F8FAFB;
    color: #37474F;
    margin-top: 0;
    padding-top: 8px;
}

QLabel#ActivityStatus {
    color: #546E7A;
    font-size: 12px;
    font-weight: 500;
}

QListWidget#ActivityLog {
    border: 1px solid #1E2D40;
    border-radius: 8px;
    padding: 4px;
    font-family: "Consolas", "Cascadia Mono", monospace;
    font-size: 12px;
    background: #0D1929;
    color: #CBD5E1;
}

QListWidget#ActivityLog::item {
    padding: 3px 6px;
    border-bottom: 1px solid #1E2D40;
}

QWidget#LogFiltersPanel {
    background: #F5F5F5;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
}

QWidget#LogFiltersPanel QCheckBox {
    color: #546E7A;
    font-size: 12px;
    font-weight: 600;
}

QWidget#LogFiltersPanel QCheckBox::indicator {
    width: 12px;
    height: 12px;
    border-radius: 3px;
}

/* ================================================================
   TAB WIDGET
   ================================================================ */

QTabWidget#ExpertTabs::pane {
    border: 1px solid #EEEEEE;
    border-radius: 10px;
    background: #FFFFFF;
    top: -1px;
}

QTabBar::tab {
    background: #F5F5F5;
    border: 1px solid #E0E0E0;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-width: 90px;
    padding: 5px 12px;
    color: #78909C;
    font-weight: 500;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #1565C0;
    font-weight: 700;
}

/* ================================================================
   SCROLL AREA
   ================================================================ */

QScrollArea {
    background: white;
    border: none;
}

QStackedWidget#PageStack {
    background: transparent;
}

/* ================================================================
   HORIZONTAL STEPPER (if used)
   ================================================================ */

QWidget#HorizontalStepper {
    background: transparent;
}

QLabel#StepLabel {
    color: #9E9E9E;
    font-size: 13px;
    font-weight: 600;
}

QLabel#StepLabel[state="active"] {
    color: #1565C0;
    font-weight: 700;
}

QLabel#StepLabel[state="done"] {
    color: #388E3C;
    font-weight: 700;
}

QLabel#StepLabel[state="pending"] {
    color: #BDBDBD;
    font-weight: 500;
}
